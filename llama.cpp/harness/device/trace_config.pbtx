# Perfetto TraceConfig for llama.cpp CPU inference telemetry.
# Deliberately minimal: only event-driven sources, no linux.perf (that would
# contend with simpleperf for PMU counters), no atrace app categories.
#
# Piped via stdin:  perfetto -c - --txt -o /data/misc/perfetto-traces/x.pb
# duration_ms is overwritten by harness.py per run.

buffers: {
  size_kb: 65536
  fill_policy: RING_BUFFER
}
buffers: {
  size_kb: 8192
  fill_policy: RING_BUFFER
}

data_sources: {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      # DVFS: fires only on frequency change, not on a poll.
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_frequency_limits"
      ftrace_events: "power/cpu_idle"
      # Which cluster each llama.cpp thread actually ran on.
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      # Thermal: thermal_zone_trip is the clean "throttling started" marker.
      ftrace_events: "thermal/thermal_temperature"
      ftrace_events: "thermal/thermal_zone_trip"
      ftrace_events: "thermal/cdev_update"
      # Our own run markers written to trace_marker.
      ftrace_events: "ftrace/print"
      atrace_apps: "lbench"
      compact_sched { enabled: true }
      drain_period_ms: 250
      buffer_size_kb: 8192
    }
  }
}

data_sources: {
  config {
    name: "linux.sys_stats"
    target_buffer: 1
    sys_stats_config {
      cpufreq_period_ms: 500
      meminfo_period_ms: 1000
      meminfo_counters: MEMINFO_MEM_AVAILABLE
    }
  }
}

data_sources: {
  config {
    name: "android.power"
    target_buffer: 1
    android_power_config {
      battery_poll_ms: 250
      battery_counters: BATTERY_COUNTER_CAPACITY_PERCENT
      battery_counters: BATTERY_COUNTER_CHARGE
      battery_counters: BATTERY_COUNTER_CURRENT
      battery_counters: BATTERY_COUNTER_VOLTAGE
      collect_power_rails: true
    }
  }
}

write_into_file: true
file_write_period_ms: 2500
duration_ms: 120000
